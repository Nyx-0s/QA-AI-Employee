{
  "name": "@consentark/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ConsentArk core backend: Fastify REST API, SQLite persistence, task queue + worker, LLM provider abstraction.",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('node:fs');fs.mkdirSync('dist/browser',{recursive:true});fs.copyFileSync('src/browser/browser-entry.ts','dist/browser/browser-entry.ts');fs.copyFileSync('src/browser/shims-browser.mjs','dist/browser/shims-browser.mjs');\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/browser/tsconfig.browser.json",
    "dev": "pnpm --filter @consentark/shared build && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@consentark/shared": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "esbuild": "0.28.2",
    "fastify": "^5.6.2",
    "nanoid": "^5.1.6",
    "page-agent": "1.12.4",
    "playwright": "^1.63.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
