{
  "name": "@consentark/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Supervisor Dashboard (React + Vite + Tailwind) — the human side of the consent flow.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --environment jsdom"
  },
  "dependencies": {
    "@consentark/shared": "workspace:*",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "jsdom": "^27.0.1",
    "tailwindcss": "^4.2.1",
    "@tailwindcss/vite": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
