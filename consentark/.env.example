# ============================================================
# ConsentArk AI Workforce — environment template
# Copy to .env and fill in. Every variable is documented.
# Secrets live ONLY here — never hardcode keys in source.
# ============================================================

# ── API server ─────────────────────────────────────────────
# Port the Fastify API listens on.
PORT=4000
# Directory for the SQLite database, screenshots, audit exports and the
# persisted operator credential (operator-token, chmod 600).
DATA_DIR=./data
# OPERATOR CREDENTIAL (Phase 5) — three modes:
#   1. Leave UNSET (or at the dev default): the server auto-generates a
#      token on first boot, prints it ONCE in the log, persists the
#      plaintext to DATA_DIR/operator-token (chmod 600) and keeps only the
#      sha256 in the database. Restarts read the file.
#   2. Set to any non-default value: that env value IS the operator
#      credential (hash-compared per request, never stored at rest).
#      Rotate by changing the env and restarting.
#   3. Either way, POST /api/operator/rotate re-issues a token at runtime
#      (unavailable in env mode — change the env instead).
# Generate a strong one with: openssl rand -hex 32
#ADMIN_TOKEN=
# Allowed browser origins for CORS. Comma-separated list, or * for any.
# Same-origin packaged deployments (docker compose) do not need this.
CORS_ORIGIN=http://localhost:5173
# Structured log level for the API server.
LOG_LEVEL=info

# ── LLM backend: cloud (FreeLLMAPI) ────────────────────────
# FreeLLMAPI serves one OpenAI-compatible endpoint (default install: :3001).
# In docker compose with the `freellmapi` profile, use the service name:
#   FREELLMAPI_URL=http://freellmapi:3000/v1
FREELLMAPI_URL=http://localhost:3001/v1
# The unified API key from the FreeLLMAPI dashboard ("freellmapi-...").
# Provider keys themselves are stored encrypted INSIDE FreeLLMAPI —
# ConsentArk never sees or stores them. No key = browser tasks fail
# honestly at the first model call.
# ↓ paste key here ↓ (then verify with: node apps/api/dist/cli/keycheck.js)
FREELLMAPI_KEY=
# Model id sent with each request. "auto" lets FreeLLMAPI's router pick,
# and its built-in failover already handles provider rate limits.
FREELLMAPI_MODEL=auto
# Per-call timeout for cloud LLM requests (ms).
FREELLMAPI_TIMEOUT_MS=60000

# ── LLM backend: local (Colibrì "coli serve") ──────────────
# OpenAI-compatible endpoint served by `coli serve` (verify the port of
# your build; Phase 0 plan assumes :8080).
COLIBRI_URL=http://localhost:8080/v1
# Small MoE model that runs on modest hardware (OLMoE 7B / Qwen3.6 35B).
COLIBRI_MODEL=OLMoE-7B
# Per-call timeout for local LLM requests (ms). Local hardware can be slow.
COLIBRI_TIMEOUT_MS=120000
# PRIVACY FLAG: if the local backend is unhealthy, may a task fall back to
# the cloud backend? Default OFF — privacy-first clients get a hard failure
# instead of data leaving the machine.
LOCAL_FALLBACK_TO_CLOUD=false

# ── LLM resilience (applies to both backends) ──────────────
# Retry attempts per LLM call (after the first try) with exponential backoff.
# Only transient failures are retried (timeouts, 408/429/5xx, network errors).
LLM_RETRIES=2
# Base delay for the exponential backoff (ms): base * 2^(attempt-1) + jitter.
LLM_RETRY_BASE_MS=500

# ── Task worker ────────────────────────────────────────────
# How many tasks the in-process worker executes concurrently.
# Keep at 1 for predictable ordering and low resource use.
WORKER_CONCURRENCY=1

# ── Browser automation (Phase 2) ───────────────────────────
# Concurrent browser contexts; one per running browser task.
BROWSER_POOL_SIZE=2
# Hard cap for page-agent's maxSteps — employee caps clamp to this.
BROWSER_MAX_STEPS_HARD_CAP=500
# Navigation + overall per-task browser timeout (ms).
BROWSER_TIMEOUT_MS=60000
# awaiting_approval tasks older than this auto-cancel (the consent clock).
APPROVAL_TIMEOUT_HOURS=24

# ── Packaging (Phase 5) ────────────────────────────────────
# Set ONLY in the packaged container (docker compose sets it): serves the
# built dashboard from the API process. Leave unset for the dev split
# (Vite on :5173 + API on :4000).
#DASHBOARD_DIST=/app/apps/dashboard/dist
# Host port for the composed stack (docker compose reads this).
CONSENTARK_PORT=4000
